{
  "name": "liquidity-vault-week-13",
  "version": "0.1.0",
  "scripts": {
    "build": "anchor build",
    "test": "npm run test:unit && npm run test:week13",
    "deploy": "anchor deploy --provider.cluster devnet",
    "ts-mocha": "ts-mocha",
    "create-pool": "ts-node scripts/create-clmm-pool.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "preflight": "node --no-experimental-strip-types -r ts-node/register scripts/week13-preflight.ts",
    "prepare-liquidity": "ts-node scripts/prepare-liquidity.ts",
    "demo": "npm run test:devnet",
    "test:unit": "node --no-experimental-strip-types -r ts-node/register node_modules/mocha/bin/mocha.js tests/slippage.ts",
    "test:devnet": "npm run week13:run -- setup && npm run week13:run -- normal && npm run week13:run -- rebalance && npm run week13:run -- cleanup",
    "test:local": "node --no-experimental-strip-types -r ts-node/register node_modules/mocha/bin/mocha.js -t 1000000 tests/vault.ts",
    "verify-rejection": "node --no-experimental-strip-types -r ts-node/register scripts/verify-rejection.ts",
    "verify:week12": "node --no-experimental-strip-types -r ts-node/register scripts/week12-verify.ts",
    "preflight:week13": "node --no-experimental-strip-types -r ts-node/register scripts/week13-preflight.ts",
    "verify:week13": "node --no-experimental-strip-types -r ts-node/register scripts/week13-verify.ts",
    "week13:run": "node --no-experimental-strip-types -r ts-node/register scripts/week13-run.ts",
    "test:week13": "node --no-experimental-strip-types -r ts-node/register node_modules/mocha/bin/mocha.js tests/week13.ts",
    "test:week13:local": "node --no-experimental-strip-types -r ts-node/register node_modules/mocha/bin/mocha.js -t 180000 tests/week13-local.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "bn.js": "^5.2.3"
  },
  "devDependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.41-alpha",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@types/chai": "^4.3.12",
    "@types/mocha": "^10.0.7",
    "chai": "^4.3.10",
    "decimal.js": "^10.6.0",
    "mocha": "^10.4.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "11.1.0"
    }
  },
  "type": "commonjs"
}
